@page "/host/{code}"
@{ ViewData["Title"] = "Jeres fest"; ViewData["Page"] = "host"; }
<main class="host-shell">
    <div class="room-topline"><span class="eyebrow">FESTENS HOVEDKVARTER</span><div class="room-chip">RUM <strong id="host-code">@RouteData.Values["code"]</strong><span class="live-dot"></span></div></div>
    <div id="host-error" class="notice" hidden></div>
    <section id="host-lobby" class="lobby-grid">
        <div class="lobby-main"><div class="eyebrow lime">INVITÉR DINE YNDLINGSMODSTANDERE</div><h1>Godt selskab.<br /><span class="lime">Snart dårlig stemning.</span></h1><p class="muted">Scan koden, vælg et navn, og find dit konkurrencegen frem.</p><div class="players-title"><h2>Hvem er med?</h2><span id="player-count" class="pill">0 spillere</span></div><div id="player-list" class="player-list"><p class="empty-state">De første rivaler er på vej …</p></div></div>
        <aside class="join-card"><div class="eyebrow">SCAN & SPIL</div><img id="qr" src="/api/rooms/@RouteData.Values["code"]/qr" alt="Scan QR-koden for at deltage i rummet" width="260" height="260" /><strong class="big-room-code">@RouteData.Values["code"]</strong><p>Eller gå til <span id="join-address"></span><br />og indtast koden.</p><button class="text-button" id="copy-link">Kopiér invitationslink ↗</button><p id="lan-note" class="lan-note" hidden>Tester I med telefoner? Åbn værtsiden via computerens lokale IP-adresse, så QR-koden også virker på mobilen.</p></aside>
        <section class="host-controls"><div class="start-row"><div><h2>Skal vi sætte gang i aftenen?</h2><p class="muted">Alle spiller med igen i næste runde.</p></div><button class="button primary" id="quick-start">Overrask os <span>ϟ</span></button></div><details id="game-picker"><summary>Eller vælg selv et spil <span>↓</span></summary><div class="picker-grid">@foreach (var game in GameCatalog.All) { <button class="pick-game" data-game="@game.Id"><span>@game.Icon</span><strong>@game.Name</strong></button> }</div></details><details class="settings"><summary>Gør festen til jeres <span>＋</span></summary><div class="settings-grid"><div><label for="click-seconds">Klikamok · sekunder</label><input id="click-seconds" type="number" value="10" min="5" max="60" /></div><div><label for="consequence">Konsekvens for de nederste</label><select id="consequence"><option value="none">Ingen konsekvens</option><option value="points">Strafpoint</option><option value="challenge">Udfordring</option><option value="custom">Egen tekst</option></select></div><div><label for="penalty-points">Antal strafpoint</label><input id="penalty-points" type="number" value="1" min="1" max="20" /></div><div class="wide"><label for="consequence-text">Jeres udfordring / egen tekst</label><input id="consequence-text" maxlength="120" placeholder="Fx: Giv din bedste sejrsdans" /></div></div><p class="muted">Valgfrit. Gælder de nederste op til 3, taberen af duellen eller den udvalgte i et tilfældighedsspil.</p></details></section>
    </section>
    <section id="host-game" hidden><div class="game-topline"><span id="round-label" class="eyebrow"></span><button class="text-button" id="back-lobby">Tilbage til lobby ↗</button></div><div id="host-game-content"></div><div id="result-actions" class="result-actions" hidden><button class="button primary" id="next-game">Næste tilfældige spil <span>→</span></button><button class="button secondary" id="choose-next">Vælg et spil</button><button class="text-button" id="pause">Stop automatisk spil</button><span id="next-countdown" class="muted"></span></div></section>
</main>
